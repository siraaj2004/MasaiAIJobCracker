# Copy to .env and fill locally. Never commit .env, never paste keys in chat.
APP_API_KEY=change-me-local-only
DATABASE_PATH=data/app.db
STORAGE_DIR=storage
MASAI_BASE_URL=https://learn.masaischool.com
MASAI_STORAGE_STATE=data/storage_state.json
# Optional: used only on the official login page if saved session is absent.
MASAI_EMAIL=
MASAI_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
TTS_PROVIDER=gtts
# Gmail API (OAuth client secrets downloaded from your own Google Cloud project)
GMAIL_CREDENTIALS_FILE=data/gmail_credentials.json
GMAIL_TOKEN_FILE=data/gmail_token.json
STUDENT_EMAIL=
CHECK_TIMES=10:00,22:00
